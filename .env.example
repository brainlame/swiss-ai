# This is a HOSTED Supabase project, including when the app runs on localhost.
# Configure its Auth email templates in the dashboard; config.toml only configures
# a local Supabase stack. See README: "Receiving a link instead of a code".
PUBLIC_SUPABASE_URL=https://sfccsrznnxivtmcixlwd.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_B9Om60zBxmkwJAiB3l0w6Q_euQVihxC
# Server-only credentials for scheduled abandoned-file cleanup (never PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=
CLEANUP_SECRET=
# Prisma validation uses this placeholder; app queries use the Supabase SDK.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The case endpoint accepts at most 512,000 bytes. No new image uploads.
BODY_SIZE_LIMIT=512K
# Public origin behind a proxy, used by vite.config.ts at build time:
APP_ORIGIN=
